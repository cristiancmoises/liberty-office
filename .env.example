# Exact browser origin, no trailing slash. HTTPS is required outside localhost.
# PT-BR: Origem exata do navegador, sem barra final. HTTPS obrigatório fora de localhost.
PUBLIC_ORIGIN=http://localhost:8097
EDITOR_ORIGIN=http://localhost:8098
EDITOR_PORT=8098
DEMO_EDITOR_ORIGIN=http://localhost:8099
DEMO_EDITOR_PORT=8099
# Loopback is the default. Use an HTTPS proxy for remote access.
# PT-BR: Loopback é o padrão. Use proxy HTTPS para acesso remoto.
LIBERTY_BIND=127.0.0.1
LIBERTY_PORT=8097
LIBERTY_VOLUME_NAME=liberty_office_data
# Bytes: global blob/revision/trash limit, initial quota, and per-upload limit.
# PT-BR: Bytes: limite global de blobs/versões/lixeira, cota inicial e tamanho por envio.
GLOBAL_QUOTA_BYTES=53687091200
DEFAULT_QUOTA_BYTES=5368709120
MAX_UPLOAD_BYTES=104857600
