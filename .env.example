# Exact browser origin, no trailing slash. HTTPS is required outside localhost.
# PT-BR: Origem exata do navegador, sem barra final. HTTPS obrigatório fora de localhost.
PUBLIC_ORIGIN=http://localhost:8097
EDITOR_ORIGIN=http://localhost:8098
EDITOR_PORT=8098
DEMO_EDITOR_ORIGIN=http://localhost:8099
DEMO_EDITOR_PORT=8099
# Loopback is the default. Use an HTTPS proxy for remote access.
# PT-BR: Loopback é o padrão. Use proxy HTTPS para acesso remoto.
LIBERTY_BIND=127.0.0.1
LIBERTY_PORT=8097
LIBERTY_VOLUME_NAME=liberty_office_data
# Bytes: global blob/revision/trash limit, initial quota, and per-upload limit.
# PT-BR: Bytes: limite global de blobs/versões/lixeira, cota inicial e tamanho por envio.
GLOBAL_QUOTA_BYTES=53687091200
DEFAULT_QUOTA_BYTES=5368709120
MAX_UPLOAD_BYTES=104857600
# Keep this much disk free after all pending and incoming bytes; dedicated hosts use 1 GiB.
# PT-BR: Reserva livre após envios pendentes e novos; hosts dedicados usam 1 GiB.
MIN_FREE_BYTES=16777216
# Open registration: enable after the operator finishes MFA and validates capacity.
# PT-BR: Cadastro público: habilite após o operador concluir o MFA e validar a capacidade.
PUBLIC_SIGNUP_ENABLED=false
PUBLIC_SIGNUP_QUOTA_BYTES=100000000
SIGNUP_ATTEMPTS=5
SIGNUP_SUCCESSES=20
SIGNUP_WINDOW_SECONDS=3600
SIGNUP_SLOTS=400
SIGNUP_PENDING_TTL_SECONDS=86400
# Empty means direct peers only. Set only the exact, verified proxy peers/CIDRs.
# PT-BR: Vazio usa apenas a conexão direta. Informe somente proxies/CIDRs exatos e verificados.
TRUSTED_PROXY_CIDRS=
