# Origem EXATA do navegador, sem barra final. HTTPS obrigatório fora de localhost.
PUBLIC_ORIGIN=http://localhost:8097
EDITOR_ORIGIN=http://localhost:8098
EDITOR_PORT=8098
# Loopback é o padrão. Use proxy HTTPS para acesso remoto.
LIBERTY_BIND=127.0.0.1
LIBERTY_PORT=8097
LIBERTY_VOLUME_NAME=liberty_office_data
# Bytes: limite global de blobs/versões/lixeira, cota inicial e tamanho por envio.
GLOBAL_QUOTA_BYTES=53687091200
DEFAULT_QUOTA_BYTES=5368709120
MAX_UPLOAD_BYTES=104857600
